# Reticulum config for Lyra Zero W gold image.
#
# LoRa (SX126x) is configured via the reticulum-hat-mod driver's profile
# system: platform=luckfox-lyra-zero-w (this board's GPIO/SPI wiring, defined
# in the sx126x_platforms overlay deployed alongside this config) +
# radio_board=meshadv-pi-hat-v1.1 (the HAT's physical pin wiring, bundled in
# the driver itself). See lyra-gold-image/dts-overlay/README.md for how the
# pin/GPIO mapping was derived and hardware-verified. NOTE: the pin/GPIO
# mapping and SPI0 bus itself are hardware-verified; end-to-end radio
# behavior through this specific HAT has not been tested yet (no physical
# HAT existed at time of writing) - if a different HAT/pinout ships, update
# the `radio_board` line (and/or the sx126x_platforms file if the SBC-side
# wiring changes) rather than editing this block's radio parameters.
#
# No TCP peer configured here, since we don't know the deployment network in
# advance - the first-boot wizard's WiFi step handles connectivity; add a
# [[Peer]]-style TCPClientInterface manually per-deployment if a known
# always-on peer (like Claw) should be reachable by default.

[reticulum]
  enable_transport = No
  share_instance = Yes
  respond_to_probes = Yes

[logging]
  loglevel = 4

[interfaces]

  [[TCP Server on LAN]]
    type = TCPServerInterface
    enabled = True
    listen_ip = 0.0.0.0
    listen_port = 4242

  [[MeshAdv LoRa]]
    type = SX126xInterface
    enabled = True
    frequency = 915000000
    bandwidth = 125000
    spreadingfactor = 7
    codingrate = 5
    txpower = 22
    platform = luckfox-lyra-zero-w
    radio_board = meshadv-pi-hat-v1.1
    # The meshadv-pi-hat-v1.1 profile defaults to bit-banged CS via libgpiod
    # (needed on Raspberry Pi's spi0-0cs setup, which has no hardware CS
    # pin). This board's LoRa pinmux overlay wires physical pin 40 as the
    # kernel's REAL hardware SPI0 CS0 instead, so bit-banging it collides
    # with the kernel's own claim on that line ("Device or resource busy").
    # Override to defer CS to spidev's hardware CE path. Hardware-verified
    # working end-to-end (SX126xInterface comes up, stable across restarts)
    # on 2026-08-04.
    pin_cs = -1

  [[I2P]]
    # Native Reticulum I2PInterface. Connects to a local i2pd SAM bridge
    # (127.0.0.1:7656, hardcoded default in RNS.vendor.i2plib - not
    # configurable here). i2pd must be installed and its SAM bridge enabled
    # (see /etc/i2pd/i2pd.conf [sam] section); reticulum-mesh.service
    # declares After=i2pd.service to ensure ordering at boot.
    #
    # connectable = True makes this node's I2P destination reachable by
    # other I2P peers (server tunnel built via SAM). Drop to False to make
    # this node only ever be a client/initiator over I2P.
    type = I2PInterface
    enabled = True
    connectable = True
