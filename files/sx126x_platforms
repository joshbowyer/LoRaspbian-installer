# SX126x interface driver platform overlay for the Luckfox Lyra Zero W.
#
# Loaded automatically by SX126xInterface.py from
# ~/.reticulum/interfaces/sx126x_platforms (this file gets copied there by
# build-lyra-gold-image.sh). Adds a new "platform" alongside the driver's
# bundled raspberry-pi / luckfox-pico profiles.
#
# CRITICAL ConfigObj format rules (do not "simplify"):
#   1. header_pin_to_line MUST be a single-quoted JSON *string*. Unquoted
#      braces/commas make ConfigObj split the value into a list and the
#      driver rejects it ("must be a JSON object string").
#   2. gpiochip paths MUST be full /dev/gpiochipN paths. Bare "gpiochip0"
#      fails on Debian Trixie libgpiod 2.x with FileNotFoundError.
#
# Physical pin -> (gpiochip, line) mapping (Luckfox Lyra Zero W):
#   11  PPS / Station-G3 TXEN  -> /dev/gpiochip0 line 3   (RM_IO3)
#   12  Pi-Hat RESET           -> /dev/gpiochip0 line 14  (RM_IO14)
#   15  Station-G3 IRQ         -> /dev/gpiochip0 line 5   (RM_IO5)
#   16  Station-G3 RXEN / PPS  -> /dev/gpiochip0 line 13  (RM_IO13)
#   18  Mini RESET / G3 BUSY   -> /dev/gpiochip0 line 12  (RM_IO12)
#   24  Mini / G3 CS (NSS)     -> /dev/gpiochip0 line 10  (RM_IO10, SPI0 CSN0)
#   32  RXEN                   -> /dev/gpiochip1 line 26  (RM_IO30)
#   33  TXEN                   -> /dev/gpiochip1 line 18  (RM_IO27)
#   36  IRQ                    -> /dev/gpiochip1 line 25  (RM_IO29)
#   38  BUSY                   -> /dev/gpiochip0 line 17  (RM_IO17)
#   40  Pi-Hat CS              -> /dev/gpiochip0 line 18  (RM_IO18)
#
# radio_board profiles (sx126x_boards / bundled):
#   meshadv-pi-hat-v1.1  CS40 RST12 IRQ36 BUSY38 RXEN32 TXEN33
#   meshadv-mini         CS24 RST18 IRQ36 BUSY38 RXEN32 (no TXEN; DIO2 RF switch)
#   station-g3           CS24 + pins 11/15/16/18 as above
#
# Overlay pairing:
#   meshadv-pi-hat-v1.1 -> lyra-zero-w-pi-header.dtbo
#   meshadv-mini        -> lyra-zero-w-meshadv-mini.dtbo
#   station-g3          -> lyra-zero-w-station-g3.dtbo
#
# Verified: lyra1 (.108) Pi Hat SX126x Up with this quoted-JSON format.
# Mini pin 24 added for MeshAdv Mini on lyra2.

[platforms]
  [[luckfox-lyra-zero-w]]
    platform_name = luckfox-lyra-zero-w
    platform_version = 1
    notes = "Luckfox Lyra Zero W (RK3506B). 40-pin header pinmux via dtoverlay. Use full /dev gpiochip paths (libgpiod 2.x). header_pin_to_line is a quoted JSON string so ConfigObj does not split on commas."
    gpiochip = /dev/gpiochip0
    spi_bus_default = 0
    header_pin_to_line = '{"11": ["/dev/gpiochip0", 3], "12": ["/dev/gpiochip0", 14], "15": ["/dev/gpiochip0", 5], "16": ["/dev/gpiochip0", 13], "18": ["/dev/gpiochip0", 12], "24": ["/dev/gpiochip0", 10], "32": ["/dev/gpiochip1", 26], "33": ["/dev/gpiochip1", 18], "36": ["/dev/gpiochip1", 25], "38": ["/dev/gpiochip0", 17], "40": ["/dev/gpiochip0", 18]}'
