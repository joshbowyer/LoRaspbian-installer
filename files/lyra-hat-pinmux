#!/bin/bash
# lyra-hat-pinmux - reconcile LoRa HAT pinmux overlay with selected HAT profile.
#
# The Lyra gold image supports mutually exclusive .dtbo overlays for the
# 40-pin header. Loading more than one Lyra HAT overlay at once is undefined
# (shared SPI pins and conflicting control-line directions). This script
# detects which HAT the user has selected and writes exactly one name into
# armbianEnv.txt's user_overlays= line. The actual pinmux change only takes
# effect at the next boot.
#
#   lyra-zero-w-pi-header           MeshAdv Pi Hat v1.1 (CS40 RST12 PPS16 in)
#   lyra-zero-w-meshadv-mini        MeshAdv Mini LoRa-only (DEFAULT for Mini)
#   lyra-zero-w-meshadv-mini-gps    MeshAdv Mini + GPS (UNSUPPORTED on vendor)
#   lyra-zero-w-station-g3          BQ / Uniteng Station G3 (pin16 = RXEN OUT)
#
# MeshAdv Mini wizard default is LoRa-only (keep FIQ console, GPS EN low).
# meshadv-mini-gps is UNSUPPORTED on vendor 6.1.115 (fiq/uart0 brick-hang).
# Onboard GPS deferred until mainline RK3506. Do not auto-inject GPS.
#
# Subcommands:
#   status                    print desired, active, match/mismatch, reboot flag
#   check                     exit 0 if match, exit 1 if mismatch (warns)
#   apply [meshadv|meshadv-mini|meshadv-mini-lora|meshadv-mini-gps|station-g3]
#                             write the chosen overlay name into armbianEnv.txt;
#                             preserves any other unrelated overlays; sets a
#                             reboot-required flag. Does NOT reboot.
#   ensure                    if mismatch, apply correct overlay for the detected
#                             desired profile (no-arg `apply`); no-op if match.
#                             Safe to call from reticulum-mesh.service start.
#
# Requires root for apply / ensure (writes to /boot/armbianEnv.txt + flag file).

set -euo pipefail

ARMBIAN_ENV="${ARMBIAN_ENV:-/boot/armbianEnv.txt}"
OVERLAY_DIR="${OVERLAY_DIR:-/boot/overlay-user}"
OVERLAY_MESHADV=lyra-zero-w-pi-header
OVERLAY_MESHADV_MINI=lyra-zero-w-meshadv-mini
OVERLAY_MESHADV_MINI_GPS=lyra-zero-w-meshadv-mini-gps
OVERLAY_STATION_G3=lyra-zero-w-station-g3
# Optional stackable diagnostic (not a HAT profile): disable fiq-debugger only.
OVERLAY_DIAG_FIQ_OFF=lyra-diag-fiq-off
HW_CONF="${HW_CONF:-/etc/lyra-hardware.conf}"
RNS_CONFIG="${RNS_CONFIG:-/home/lyra/.reticulum/config}"
REBOOT_FLAG_DIR="${REBOOT_FLAG_DIR:-/var/lib/lyra}"
REBOOT_FLAG="${REBOOT_FLAG:-${REBOOT_FLAG_DIR}/hat-pinmux-reboot-required}"
MESHTASTIC_CANDIDATES=(
	/etc/meshtasticd/config.yaml
	/etc/meshtasticd/config.yml
	/root/.portduino/default/prefs/config.yaml
)

# Lyra-managed overlay basenames stripped on apply.
# Match GPS basename before LoRa-only (prefix overlap).
LYRA_OVERLAYS=(
	"$OVERLAY_MESHADV_MINI_GPS"
	"$OVERLAY_MESHADV_MINI"
	"$OVERLAY_STATION_G3"
	"$OVERLAY_MESHADV"
	"$OVERLAY_DIAG_FIQ_OFF"
)

usage() {
	cat <<EOF
Usage: $0 {status|check|apply [meshadv|meshadv-mini|meshadv-mini-lora|meshadv-mini-gps|station-g3]|ensure}
  status           Show desired vs active overlay, mismatch warning if any,
                   and whether a reboot is pending.
  check            Exit 0 if active overlay matches the desired profile,
                   exit 1 (with a clear warning) otherwise.
  apply [profile]  Set user_overlays in ${ARMBIAN_ENV} to the given profile
                   (default: detected profile). Removes other Lyra
                   overlays if present, preserves other unrelated overlays,
                   writes a reboot-required flag. Does NOT reboot.
                   meshadv-mini       → Mini LoRa-only (wizard default)
                   meshadv-mini-lora  → same as meshadv-mini (alias)
                   meshadv-mini-gps   → Mini + GPS EXPERIMENTAL (fiq off + uart0)
  ensure           If a mismatch is detected, apply the correct overlay
                   (same as apply with no arg) and report; no-op if match.
                   Safe to call from reticulum-mesh.service start.
EOF
}

err() { printf 'lyra-hat-pinmux: %s\n' "$*" >&2; }
log() { printf 'lyra-hat-pinmux: %s\n' "$*"; }

require_root() {
	if [ "${EUID:-$(id -u)}" -ne 0 ]; then
		err "this subcommand must be run as root (writes ${ARMBIAN_ENV} and ${REBOOT_FLAG})"
		exit 1
	fi
}

trim_space() {
	printf '%s' "$1" | tr -s ' \t' ' '
}

# Atomic rewrite of armbianEnv.txt.
# sed -i truncates then rewrites in place; a power cut mid-write can leave the
# file all 0x00 (seen 2026-09-08 on lyra3) which bricks boot with solid red LED
# even when KEYED U-Boot is intact. Write tmp → fsync → rename instead.
write_armbian_env() {
	local content=$1
	local dir tmp
	dir=$(dirname -- "$ARMBIAN_ENV")
	tmp=$(mktemp "${dir}/.armbianEnv.txt.XXXXXX")
	# Refuse to install empty/all-null content
	if [ -z "${content//$'\n'/}" ]; then
		rm -f "$tmp"
		err "ERROR: refusing to write empty ${ARMBIAN_ENV}"
		return 1
	fi
	printf '%s' "$content" > "$tmp"
	# Ensure trailing newline
	[ -n "$content" ] && [ "${content: -1}" != $'\n' ] && printf '\n' >> "$tmp"
	# Sanity: must contain rootdev= or fdtfile= (Armbian boot essentials)
	if ! grep -qE '^(rootdev|fdtfile)=' "$tmp"; then
		rm -f "$tmp"
		err "ERROR: refusing to write ${ARMBIAN_ENV} missing rootdev=/fdtfile="
		return 1
	fi
	sync "$tmp" 2>/dev/null || true
	mv -f "$tmp" "$ARMBIAN_ENV"
	sync "$(dirname -- "$ARMBIAN_ENV")" 2>/dev/null || sync || true
}

set_user_overlays_line() {
	local new_list=$1
	local content
	if [ ! -f "$ARMBIAN_ENV" ]; then
		err "ERROR: ${ARMBIAN_ENV} does not exist; cannot set user_overlays"
		return 2
	fi
	if grep -q '^[[:space:]]*user_overlays[[:space:]]*=' "$ARMBIAN_ENV"; then
		content=$(awk -v nl="$new_list" '
			BEGIN { done=0 }
			/^[[:space:]]*user_overlays[[:space:]]*=/ {
				print "user_overlays=" nl
				done=1
				next
			}
			{ print }
			END {
				if (!done) print "user_overlays=" nl
			}
		' "$ARMBIAN_ENV")
	else
		content=$(cat "$ARMBIAN_ENV")
		content="${content}"$'\n'"user_overlays=${new_list}"
	fi
	write_armbian_env "$content"
}

get_user_overlays() {
	if [ -f "$ARMBIAN_ENV" ]; then
		awk -F= '
			/^[[:space:]]*user_overlays[[:space:]]*=/ {
				$1=""; sub(/^[[:space:]]*/, "");
				print; exit
			}' "$ARMBIAN_ENV"
	fi
}

# Echoes one of: meshadv-mini, meshadv-mini-gps, meshadv, station-g3, none
# GPS basename must be matched before LoRa-only (shared prefix).
detect_active() {
	local value
	value=$(get_user_overlays)
	if printf '%s' "$value" | grep -qE "(^|[[:space:]])${OVERLAY_STATION_G3}([[:space:]]|$)"; then
		echo station-g3
	elif printf '%s' "$value" | grep -qE "(^|[[:space:]])${OVERLAY_MESHADV_MINI_GPS}([[:space:]]|$)"; then
		echo meshadv-mini-gps
	elif printf '%s' "$value" | grep -qE "(^|[[:space:]])${OVERLAY_MESHADV_MINI}([[:space:]]|$)"; then
		echo meshadv-mini
	elif printf '%s' "$value" | grep -qE "(^|[[:space:]])${OVERLAY_MESHADV}([[:space:]]|$)"; then
		echo meshadv
	else
		echo none
	fi
}

# Echoes one of: meshadv, meshadv-mini, meshadv-mini-gps, station-g3
# meshadv-mini-lora is accepted as an alias for meshadv-mini.
detect_desired() {
	local explicit=${1:-}
	if [ -n "$explicit" ]; then
		case "$explicit" in
			meshadv|meshadv-mini|meshadv-mini-gps|station-g3) echo "$explicit"; return 0 ;;
			meshadv-mini-lora) echo meshadv-mini; return 0 ;;
			*) err "unknown profile '$explicit' (use meshadv, meshadv-mini, meshadv-mini-lora, meshadv-mini-gps, or station-g3)"; return 2 ;;
		esac
	fi

	# 1. /etc/lyra-hardware.conf: hat= or radio_board= (and optional gps=)
	if [ -r "$HW_CONF" ]; then
		local hw gps
		hw=$(awk -F= '
			/^[[:space:]]*(hat|radio_board)[[:space:]]*=/ {
				$1=""; sub(/^[[:space:]]*/, "");
				gsub(/[[:space:]]*$/, "");
				print; exit
			}' "$HW_CONF" 2>/dev/null) || true
		gps=$(awk -F= '
			/^[[:space:]]*gps[[:space:]]*=/ {
				$1=""; sub(/^[[:space:]]*/, "");
				gsub(/[[:space:]]*$/, "");
				print; exit
			}' "$HW_CONF" 2>/dev/null) || true
		case "$hw" in
			station-g3|station_g3|g3|stationg3) echo station-g3; return 0 ;;
			meshadv-mini|meshadv_mini|meshadv-mini-hat)
				case "${gps,,}" in
					1|yes|on|true|gps|enable|enabled) echo meshadv-mini-gps; return 0 ;;
					*) echo meshadv-mini; return 0 ;;
				esac
				;;
			meshadv|meshadv-pi-hat|meshadv-pi-hat-v1.1|wio-sx1262|wio)
				echo meshadv; return 0 ;;
		esac
	fi

	# 2. Reticulum config: radio_board=  (Mini → LoRa-only unless hw.conf gps=on)
	if [ -r "$RNS_CONFIG" ]; then
		local rb
		rb=$(awk '
			BEGIN { IGNORECASE=0 }
			/^[[:space:]]*#/ { next }
			/radio_board[[:space:]]*=/ {
				sub(/.*radio_board[[:space:]]*=[[:space:]]*/, "");
				gsub(/[[:space:]]*$/, "");
				print; exit
			}' "$RNS_CONFIG" 2>/dev/null) || true
		case "$rb" in
			station-g3|station_g3) echo station-g3; return 0 ;;
			meshadv-mini*|meshadv_mini*) echo meshadv-mini; return 0 ;;
			*"meshadv"*) echo meshadv; return 0 ;;
		esac
	fi

	# 3. Meshtastic config hints
	local f
	for f in "${MESHTASTIC_CANDIDATES[@]}"; do
		if [ -r "$f" ]; then
			if grep -qiE 'station[-_ ]?g3|uniteng' "$f" 2>/dev/null; then
				echo station-g3; return 0
			fi
			if grep -qiE 'meshadv[-_ ]?mini' "$f" 2>/dev/null; then
				echo meshadv-mini; return 0
			fi
			if grep -qi 'meshtastic' "$f" 2>/dev/null; then
				echo meshadv; return 0
			fi
		fi
	done

	# 4. Default.
	echo meshadv
}

overlay_for() {
	case "$1" in
		station-g3)         echo "$OVERLAY_STATION_G3" ;;
		meshadv-mini)       echo "$OVERLAY_MESHADV_MINI" ;;
		meshadv-mini-gps)   echo "$OVERLAY_MESHADV_MINI_GPS" ;;
		meshadv)            echo "$OVERLAY_MESHADV" ;;
		*) err "internal: unknown profile '$1'"; return 2 ;;
	esac
}

friendly_name() {
	case "$1" in
		station-g3)         echo "Station G3 (pin16 = RXEN out)" ;;
		meshadv-mini)       echo "MeshAdv Mini LoRa-only (GPS off, FIQ console kept)" ;;
		meshadv-mini-gps)   echo "MeshAdv Mini + GPS EXPERIMENTAL (uart0 NMEA)" ;;
		meshadv)            echo "MeshAdv Pi Hat v1.1 (CS40 RST12 PPS16 in)" ;;
		*) echo "$1" ;;
	esac
}

# After Mini+GPS apply: stop FIQ getty from fighting a disabled debugger.
# Best-effort; overlay is what actually frees UART0.
sync_fiq_getty() {
	local desired=$1
	if [ "$desired" = "meshadv-mini-gps" ]; then
		systemctl disable --now serial-getty@ttyFIQ0.service 2>/dev/null || true
		systemctl mask serial-getty@ttyFIQ0.service 2>/dev/null || true
		log "masked serial-getty@ttyFIQ0 (Mini+GPS takes UART0; use SSH)"
	else
		# Restore FIQ getty when leaving Mini+GPS (other profiles keep FIQ console).
		if systemctl is-enabled serial-getty@ttyFIQ0.service >/dev/null 2>&1 || \
		   systemctl is-enabled serial-getty@ttyFIQ0.service 2>&1 | grep -qi masked; then
			systemctl unmask serial-getty@ttyFIQ0.service 2>/dev/null || true
			systemctl enable serial-getty@ttyFIQ0.service 2>/dev/null || true
			log "unmasked serial-getty@ttyFIQ0 for non-GPS Mini / other HAT profiles"
		fi
	fi
}

cmd_status() {
	local desired active
	desired=$(detect_desired)
	active=$(detect_active)
	echo "desired overlay profile : $desired  ($(friendly_name "$desired"))"
	echo "active  overlay in armbianEnv.txt : $active"
	if [ "$desired" = "$active" ]; then
		echo "state                   : MATCH"
	else
		echo "state                   : MISMATCH"
	fi
	if [ -f "$REBOOT_FLAG" ]; then
		echo "reboot required         : YES (flag at $REBOOT_FLAG)"
	else
		echo "reboot required         : no"
	fi
	local ov
	ov=$(overlay_for "$desired" 2>/dev/null || true)
	if [ -n "$ov" ]; then
		echo "desired dtbo            : ${ov}.dtbo"
	fi
}

cmd_check() {
	local desired active
	desired=$(detect_desired)
	active=$(detect_active)
	if [ "$desired" = "$active" ]; then
		log "OK: armbianEnv.txt overlay matches desired profile ($desired)"
		return 0
	fi
	err "WARNING: config wants $(friendly_name "$desired") but active overlay is $(friendly_name "$active"). Run '$0 apply' then REBOOT before starting the radio safely."
	return 1
}

cmd_apply() {
	require_root
	local desired explicit
	explicit=${1:-}
	desired=$(detect_desired "$explicit")
	local overlay_wanted
	overlay_wanted=$(overlay_for "$desired")

	if [ ! -f "${OVERLAY_DIR}/${overlay_wanted}.dtbo" ]; then
		err "ERROR: ${OVERLAY_DIR}/${overlay_wanted}.dtbo not found; refusing to switch"
		exit 2
	fi

	if [ "$desired" = "meshadv-mini-gps" ]; then
		log "WARNING: meshadv-mini-gps is UNSUPPORTED on vendor kernel (brick-hang). Prefer meshadv-mini (LoRa-only). GPS lands with mainline RK3506."
	fi

	mkdir -p "$REBOOT_FLAG_DIR"

	local current
	current=$(get_user_overlays)

	local new_list="" tok
	if [ -n "$current" ]; then
		for tok in $current; do
			case "$tok" in
				"${OVERLAY_MESHADV}"|"${OVERLAY_MESHADV_MINI}"|"${OVERLAY_MESHADV_MINI_GPS}"|"${OVERLAY_STATION_G3}"|"${OVERLAY_DIAG_FIQ_OFF}")
					continue ;;
				*) new_list="${new_list:+${new_list} }$tok" ;;
			esac
		done
	fi

	new_list=$(trim_space "${new_list:+${new_list} }${overlay_wanted}")

	set_user_overlays_line "$new_list" || exit $?

	date -Iseconds > "$REBOOT_FLAG"
	sync "$REBOOT_FLAG" 2>/dev/null || true
	sync_fiq_getty "$desired"

	local active_after
	active_after=$(detect_active)
	if [ "$active_after" != "$desired" ]; then
		err "ERROR: failed to set user_overlays to ${overlay_wanted}; active still ${active_after}"
		exit 1
	fi

	log "WARNING: Config wants $(friendly_name "$desired") but pinmux overlay was previously $(friendly_name "$(detect_active_pre "$current")"). Updated ${ARMBIAN_ENV} - REBOOT REQUIRED before starting the radio safely."
	log "active overlay after apply: $active_after (${overlay_wanted}.dtbo)"
	log "reboot-required flag written to $REBOOT_FLAG"
	log "do NOT reboot automatically; reboot manually when ready"
}

detect_active_pre() {
	case "$1" in
		*"${OVERLAY_STATION_G3}"*)       echo station-g3 ;;
		*"${OVERLAY_MESHADV_MINI_GPS}"*) echo meshadv-mini-gps ;;
		*"${OVERLAY_MESHADV_MINI}"*)     echo meshadv-mini ;;
		*"${OVERLAY_MESHADV}"*)          echo meshadv ;;
		*)                               echo none ;;
	esac
}

cmd_ensure() {
	local desired active
	desired=$(detect_desired)
	active=$(detect_active)
	if [ "$desired" = "$active" ]; then
		if [ -f "$REBOOT_FLAG" ]; then
			log "WARNING: pinmux change still pending reboot (flag at $REBOOT_FLAG); radio may be unsafe until reboot"
		fi
		log "OK: pinmux overlay matches desired profile ($desired)"
		return 0
	fi
	log "MISMATCH detected: desired=$desired active=$active - applying..."
	cmd_apply "$desired"
}

case "${1:-}" in
	status)  cmd_status ;;
	check)   cmd_check ;;
	apply)
		shift || true
		cmd_apply "${1:-}"
		;;
	ensure)  cmd_ensure ;;
	-h|--help|help|"") usage ;;
	*) usage; exit 2 ;;
esac
