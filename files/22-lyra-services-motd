#!/bin/bash
# update-motd.d script: shows the state of the mesh-relevant services this
# image actually manages. Kept separate from Armbian's own 41-commands
# script (which already lists armbian-config/armbian-upgrade dynamically).

set -o pipefail

SERVICES=(nomadnet rngit meshtasticd)
name_len=0
for s in "${SERVICES[@]}"; do
	[[ ${#s} -gt ${name_len} ]] && name_len=${#s}
done

echo ""
printf "\e[0;90m Services: \x1B[0m\n"
echo ""
for svc in "${SERVICES[@]}"; do
	if systemctl is-enabled --quiet "${svc}.service" 2>/dev/null; then
		if systemctl is-active --quiet "${svc}.service" 2>/dev/null; then
			state="\e[0;92mactive\e[0m"
		else
			state="\e[0;93menabled, not running\e[0m"
		fi
	else
		state="\e[0;90mdisabled\e[0m"
	fi
	printf " \e[1;33m%-${name_len}s\e[0m: %b\n" "${svc}" "${state}"
done

exit 0
